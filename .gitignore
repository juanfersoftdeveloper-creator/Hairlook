frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# === BACKEND (PHP) ===
# Archivos de configuración con contraseñas de la base de datos
backend/config.local.php
backend/conexion_secreta.php
# Si usas variables de entorno en PHP:
backend/.env
backend/backups/

